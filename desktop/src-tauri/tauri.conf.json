{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeakBot Desktop",
  "mainBinaryName": "peakbot-desktop",
  "identifier": "com.peakbot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": ["local-pages", "remote-web"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "externalBin": ["binaries/peakbot"],
    "category": "DeveloperTool",
    "shortDescription": "PeakBot desktop app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/peakbot-desktop/fonts/NotoColorEmoji.ttf": "linux/fonts/NotoColorEmoji.ttf",
          "/usr/share/peakbot-desktop/fonts/OFL.txt": "linux/fonts/OFL.txt"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1RjNEMDk1Njg2NTFERjEKUldUeEhXVm9sZER6cFZWWTNUd3loNnJuZy9UaGN1TW9uTlg4bjZtSzJBK0JMYlg1aEV4WWttY2sK",
      "endpoints": ["https://github.com/thepeak99/peakbot/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
