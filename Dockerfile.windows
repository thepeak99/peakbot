# PeakBot Windows Cross-Compile Builder
# Usage: podman build --output type=local,dest=./output .
# (or: docker build --output type=local,dest=./output .)
#
# Target: x86_64-pc-windows-msvc — clang/lld/llvm + cargo-xwin (MSVC SDK),
# built with a static CRT — no VC++ redistributable is needed. This is the
# ONE Windows build: the server asset (`make build-windows` /
# `make release-build-windows` → output/peakbot[-<v>]-windows-amd64.exe)
# and the desktop sidecar (desktop/scripts/build-desktop.sh →
# output/peakbot-windows-amd64-msvc.exe) are the same build stage with the
# same args, so the release pipeline builds it once and the desktop
# sidecar step is a BuildKit cache hit.
# (The old gnu/mingw branch is gone: msvc is what the sidecar always used,
# so the server asset now links against the runtime every Windows machine
# ships.)

# ── Web UI build (Node) ────────────────────────────────────────────────
# Stage `web`: produces /web/dist with the SPA bundle. The rust build copies
# this into the crate root so `rust-embed` inlines it.
FROM node:22 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ── Rust build ─────────────────────────────────────────────────────────
# Stage `builder`: owns the entire cargo build, including the final .exe that
# the scratch stage exports. This stage MUST be referenced by the final
# `COPY --from=`, otherwise BuildKit will prune it along with the binary.
FROM ghcr.io/rust-lang/rust:1.91-bookworm AS builder

# Windows x86_64, MSVC ABI. Declared as an ARG (and re-declared in the
# scratch stage — ARG scope is per-stage) so the desktop pipeline's
# explicit `--build-arg TARGET=x86_64-pc-windows-msvc` stays a no-op of
# identical value: same layer, same cache.
ARG TARGET=x86_64-pc-windows-msvc
ENV TARGET=${TARGET}

# Cross-compile toolchain: clang/lld/llvm — cargo-xwin compiles the C deps
# (ring, zstd-sys) with clang against the MSVC SDK.
RUN apt-get update \
    && apt-get install -y --no-install-recommends clang lld llvm \
    && rm -rf /var/lib/apt/lists/*

# Add Windows target
RUN rustup target add ${TARGET} \
    && rustup target list --installed

# cargo-xwin drives the MSVC SDK download + linker environment
# (pinned — the MSVC SDK protocol it speaks must match the version that was
# verified by the spike). XWIN_ACCEPT_LICENSE keeps the SDK license prompt
# non-interactive; XWIN_CACHE_DIR pins the SDK cache so the pre-warmed
# dep-cache build below reuses it. CARGO_TARGET_…_RUSTFLAGS is
# target-scoped, so it applies to the dep-cache build and the real build
# alike.
# +crt-static: the binary imports no vcruntime/msvcp/ucrtbase — no VC++
# redistributable is needed on the target machine.
ENV XWIN_ACCEPT_LICENSE=1 \
    XWIN_CACHE_DIR=/root/.cache/cargo-xwin \
    CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_RUSTFLAGS="-C target-feature=+crt-static"
RUN cargo install --locked cargo-xwin@0.23.1

WORKDIR /build
COPY Cargo.toml Cargo.lock* ./
# vendor/ must land before the dep-cache build: [patch.crates-io] in
# Cargo.toml resolves termios from this vendored path (see vendor/README.md).
COPY vendor/ vendor/

RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs

RUN cargo xwin build --target ${TARGET} --release --locked \
    && rm -rf target/${TARGET}/deps/*.rlib target/${TARGET}/deps/*.d

# build.rs MUST be in the COPY set — the dummy-main dep-cache layer doesn't
# run it, and a new build.rs would otherwise silently never execute.
# `build/` is required because build.rs uses `include_str!("build/stub_index.html")`
# at compile time (the fail-safe stub for node-free builds); without it the
# build script itself fails to compile.
COPY build.rs ./
COPY build/ build/
COPY --from=web /web/dist ./web/dist
COPY src/ src/

RUN touch src/main.rs && cargo xwin build --release --locked --target ${TARGET}

# Stage the .exe under the two names it ships as (same bytes, one build):
#  peakbot-windows-amd64-msvc.exe        — the desktop sidecar name; the
#                                          desktop pipeline (build-desktop.sh /
#                                          Dockerfile.desktop-windows) stages
#                                          it by this name
#  peakbot[-VERSION]-windows-amd64.exe   — the server asset
#                                          (make build-windows /
#                                           release-build-windows)
# (ARG VERSION is re-declared: ARG scope is per-stage, and the scratch
# stage below needs its own copy for the documentation. It is declared
# HERE, last, so the expensive layers above are shared between the
# unversioned and versioned builds.)
ARG VERSION=
RUN mkdir -p /stage \
    && cp "target/${TARGET}/release/peakbot.exe" /stage/peakbot-windows-amd64-msvc.exe \
    && cp "target/${TARGET}/release/peakbot.exe" "/stage/peakbot${VERSION:+-${VERSION}}-windows-amd64.exe"

# Export the .exe(s), named with the release/version + platform suffix so
# the Makefile doesn't have to rename them post-build.
FROM scratch
ARG TARGET=x86_64-pc-windows-msvc
# VERSION is injected by `make release-build-windows` from Cargo.toml.
# Unset (default): server artifact is `peakbot-windows-amd64.exe`.
# Set to e.g. 0.2.0: server artifact is `peakbot-0.2.0-windows-amd64.exe`.
# The desktop sidecar name `peakbot-windows-amd64-msvc.exe` is versionless
# in both cases.
ARG VERSION=
COPY --from=builder /stage/ /