# Web UI build artefacts — generated by `make web` (or by `build.rs` as a
# node-free stub). The directory itself is kept in git via `.gitkeep`.
# Patterns are relative to THIS file's location (per gitignore per-dir
# semantics), not the repo root — so no `web/` prefix.
dist/*
!dist/.gitkeep

# Node deps installed by `make web` / `npm install`.
node_modules/
