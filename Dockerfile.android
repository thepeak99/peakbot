# PeakBot Android (Termux) Cross-Compile Builder
#
# Produces a standalone aarch64 terminal binary for Termux. This is NOT an APK
# and NOT a jniLibs `.so`; it's a plain CLI/TUI executable.
#
# Target is `aarch64-unknown-linux-musl`, NOT `aarch64-linux-android`, on
# purpose: PeakBot's TLS stack (rustls via reqwest) pulls in
# `rustls-platform-verifier`, whose Android backend calls into the JVM for
# certificate verification. A Termux/CLI binary has no JVM, so that backend
# panics at the first HTTPS request ("expect rustls platform verifier to be
# initialized"). The platform-verifier's JVM code path is gated on
# `target_os = "android"`; building for linux-musl selects its Unix backend
# instead, which reads roots from the system trust store. A bare device has
# none, so the binary embeds the Mozilla CA bundle and points SSL_CERT_FILE at
# it at startup (see `src/ca_certs.rs`, behind the `embed-ca-certs` feature
# enabled below) — no `ca-certificates` install needed. A fully static musl
# binary runs fine under Termux and `adb shell` alike — no NDK, no bionic, no
# JVM.
#
# Usage:
#   podman build -f Dockerfile.android --output type=local,dest=./output .
#   docker build -f Dockerfile.android --output type=local,dest=./output .

# cargo-zigbuild + zig supply a complete musl C sysroot, so the C deps rustls
# pulls in (aws-lc-sys/BoringSSL) cross-compile cleanly — a plain glibc cross
# gcc can't find musl's headers. Same builder image Dockerfile.macos uses.
FROM ghcr.io/rust-cross/cargo-zigbuild:latest AS builder

# arm64 covers essentially every modern Android phone. musl → fully static.
ARG TARGET=aarch64-unknown-linux-musl
ENV TARGET=${TARGET}

RUN rustup target add ${TARGET} \
    && rustup target list --installed

# Copy manifests first for better layer caching
WORKDIR /build
COPY Cargo.toml Cargo.lock* ./

# Create dummy main.rs for dependency caching
RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs

# Build dependencies only (faster layer caching)
RUN cargo zigbuild --release --features embed-ca-certs --target ${TARGET}

# Copy actual source
COPY src/ src/

# Build the actual binary (touch main.rs so cargo rebuilds the bin crate; deps stay cached)
RUN touch src/main.rs && \
    cargo zigbuild --release --features embed-ca-certs --target ${TARGET}

# Export only the binary, named with the release/version + platform suffix so
# the Makefile doesn't have to rename it post-build.
FROM scratch
ARG TARGET=aarch64-unknown-linux-musl
# VERSION is injected by `make release-build-android` from .release-version.
# Unset (default): artifact is `peakbot-android-arm64`.
# Set to e.g. 0.2.0: artifact is `peakbot-0.2.0-android-arm64`.
ARG VERSION=
COPY --from=builder /build/target/${TARGET}/release/peakbot /peakbot${VERSION:+-${VERSION}}-android-arm64
