# PeakBot Android Cross-Compile Builder
#
# Produces a standalone aarch64 (arm64-v8a) terminal binary for Android —
# runnable in Termux or via `adb shell`. This is NOT an APK and NOT a jniLibs
# `.so`; it's a plain CLI/TUI executable for the `aarch64-linux-android` target.
#
# Cross-compilation needs the Android NDK (which ships the clang linker) plus
# `cargo-ndk`, which auto-detects the NDK and sets every CC/AR/linker env var
# correctly (the NDK linker path embeds the host triple AND NDK version, so
# auto-detection keeps this Dockerfile from hardcoding a brittle path).
#
# PeakBot is pure rustls/ring (no openssl-sys), so there is no Android system
# SSL to link against — the usual Android cross-compile wall does not apply.
#
# Usage:
#   podman build -f Dockerfile.android --output type=local,dest=./output .
#   docker build -f Dockerfile.android --output type=local,dest=./output .

# ── Web UI build (Node) ────────────────────────────────────────────────
# Stage `web`: produces /web/dist with the SPA bundle. The rust build copies
# this into the crate root so `rust-embed` inlines it.
FROM node:22 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ── Rust build ─────────────────────────────────────────────────────────
# Stage `builder`: owns the entire cargo build, including the final binary
# that the scratch stage exports. This stage MUST be referenced by the final
# `COPY --from=`, otherwise BuildKit will prune it along with the binary.
FROM ghcr.io/rust-lang/rust:1.91-bookworm AS builder

# arm64-v8a covers essentially every modern Android phone.
ARG TARGET=aarch64-linux-android
ENV TARGET=${TARGET}

# Minimum Android API level (24 = Android 7.0, the Termux floor).
# Set via CARGO_NDK_PLATFORM rather than a CLI flag: cargo-ndk v4's `-p`
# collides with cargo's `--package` passthrough, so the env var is unambiguous.
ARG ANDROID_API=24
ENV CARGO_NDK_PLATFORM=${ANDROID_API}

# Pinned NDK revision (LTS). Bump deliberately.
ARG NDK_VERSION=r27c

# Install the NDK (provides the clang cross-linker) + cargo-ndk.
RUN apt-get update && apt-get install -y --no-install-recommends \
        unzip curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/ndk.zip \
        "https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip" \
    && unzip -q /tmp/ndk.zip -d /opt \
    && rm /tmp/ndk.zip
ENV ANDROID_NDK_HOME=/opt/android-ndk-${NDK_VERSION}

# Add the Rust target and the cargo-ndk extension.
RUN rustup target add ${TARGET} \
    && rustup target list --installed \
    && cargo install cargo-ndk --locked

WORKDIR /build
COPY Cargo.toml Cargo.lock* ./

RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs

RUN cargo ndk -t ${TARGET} build --release && \
    rm -rf target/${TARGET}/deps/*.rlib target/${TARGET}/deps/*.d

# build.rs MUST be in the COPY set.
COPY build.rs ./
COPY --from=web /web/dist ./web/dist
COPY src/ src/

RUN touch src/main.rs && \
    cargo ndk -t ${TARGET} build --release

# Export only the binary, named with the release/version + platform suffix so
# the Makefile doesn't have to rename it post-build.
FROM scratch
ARG TARGET=aarch64-linux-android
# VERSION is injected by `make release-build-android` from .release-version.
# Unset (default): artifact is `peakbot-android-arm64`.
# Set to e.g. 0.2.0: artifact is `peakbot-0.2.0-android-arm64`.
ARG VERSION=
COPY --from=builder /build/target/${TARGET}/release/peakbot /peakbot${VERSION:+-${VERSION}}-android-arm64