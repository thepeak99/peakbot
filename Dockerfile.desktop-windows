# PeakBot Desktop — Windows portable exe + NSIS installer (DESIGN
# §5.7, amendment (windows-nsis) 2026-10-27).
#
# ONE image cross-builds the Tauri desktop app for x86_64-pc-windows-msvc
# and exports TWO artifacts:
#   1. the self-extracting portable exe — plain `cargo xwin`, NO Tauri CLI
#      (the macOS pipeline proves tauri-build + tauri/custom-protocol does
#      everything the CLI did: ACL, externalBin check, icon/version .rc,
#      static vcruntime, embedded ui/).
#   2. the per-user NSIS installer — the pinned Tauri CLI (same pin as
#      Dockerfile.desktop-linux) run with `--bundles nsis --runner cargo-xwin`
#      on the SAME warm target/ (I-C: the portable is copied out first,
#      because the CLI patches target/…/peakbot-desktop.exe in place).
# The peakbot sidecar is staged into src-tauri/binaries/ and embedded as a
# zstd payload by src-tauri/build.rs; the app extracts it on first launch.
#
# The base image is rust:1.91-trixie (not bookworm): trixie's NSIS 3.11
# ships Include/Win/RestartManager.nsh, which Tauri's installer.nsi
# includes. The RestartManager.nsh guard below is the real requirement.
#
# Usage: podman build --build-arg VERSION=<v> \
#          --output type=local,dest=output/desktop \
#          -f Dockerfile.desktop-windows .
#
# The S-W1..S-W6 smoke checks (desktop/scripts/smoke-windows.sh) run on
# BOTH artifacts BEFORE the scratch export; any failure fails this build.

FROM ghcr.io/rust-lang/rust:1.91-trixie AS build

# clang lld llvm: xwin C/link + llvm-rc (tauri_winres compiles the
# icon/version .rc into .rsrc) + llvm-objdump (the S-W3 import-table
# smoke check). file: S-W2/S-W5. nsis: makensis. 7zip: S-W6 inspects
# the NSIS installer archive (7z).
# libayatana-appindicator3-dev: the Tauri CLI (host-side) probes for an
# appindicator library before bundling and ABORTS without it — measured
# failure on trixie: `thread '<unnamed>' panicked at
# crates/tauri-cli/src/interface/rust.rs:1702:17: Can't detect any
# appindicator library` (Tauri CLI 2.12.3, 2026-10-28). Nothing in the
# Windows-target build links it; the probe is a Linux-host artifact.
RUN apt-get update && apt-get install -y --no-install-recommends \
        clang \
        lld \
        llvm \
        file \
        nsis \
        7zip \
        libayatana-appindicator3-dev \
    && rm -rf /var/lib/apt/lists/*

# Fail fast (right after the layer that installs them) if the toolchain is
# missing: a future base-image/package change must surface here with a
# clear message, not deep inside the cargo build. NOTE: Debian's
# llvm-rc has NO --version subcommand (it exits 1), so the guard is
# `command -v` + a version line from llvm-objdump. The RestartManager.nsh
# test pins the real NSIS requirement (a package pin would only
# duplicate it).
RUN command -v llvm-rc && command -v llvm-objdump && command -v makensis && command -v 7z \
    && llvm-objdump --version | head -1 \
    && test -f /usr/share/nsis/Include/Win/RestartManager.nsh \
    || { echo "toolchain/NSIS guard failed (need llvm-rc, llvm-objdump, makensis, 7z and NSIS >= 3.09 RestartManager.nsh)" >&2; exit 1; }

# Node 22 (nodesource) — runs the pinned Tauri CLI via npx (same pin as
# Dockerfile.desktop-linux).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add x86_64-pc-windows-msvc

# cargo-xwin drives the MSVC SDK download + linker environment
# (pinned — the MSVC SDK protocol it speaks must match the version that
# was verified by the spike). XWIN_ACCEPT_LICENSE keeps the SDK license
# prompt non-interactive; XWIN_CACHE_DIR pins the SDK cache location so
# the pre-warm below is reused by the real build. CARGO_BUILD_JOBS bounds
# parallel codegen (a 32-way release build of the Tauri stack peaks past
# what a shared dev host can spare — same rationale as the Linux build).
ENV XWIN_ACCEPT_LICENSE=1 \
    XWIN_CACHE_DIR=/root/.cache/cargo-xwin \
    CARGO_BUILD_JOBS=8
RUN cargo install --locked cargo-xwin@0.23.1

# Pre-warm the MSVC SDK cache in its own layer with a throwaway xwin
# build: the ~100 MB SDK download happens HERE, so a failure in any later
# layer (and every rebuild) reuses it from the cache instead of
# re-downloading.
RUN mkdir -p /xwin-warm/src \
    && echo "fn main() {}" > /xwin-warm/src/main.rs \
    && printf '[package]\nname = "xwin-warm"\nversion = "0.1.0"\nedition = "2021"\n\n[workspace]\n' > /xwin-warm/Cargo.toml \
    && cd /xwin-warm && cargo xwin build --release --target x86_64-pc-windows-msvc

ARG VERSION
# Root Cargo.toml is the version source for scripts/check-version.sh (it
# compares root [package].version against desktop [workspace.package].version).
COPY Cargo.toml /src/Cargo.toml
COPY desktop/ /src/desktop

# The peakbot sidecar from the Dockerfile.windows msvc build (unversioned
# artifact name — must match build-desktop.sh). Named with the full target
# triple so tauri-build's externalBin check passes; src-tauri/build.rs
# reads the SAME file and embeds it as the zstd payload (I1: identity =
# content — the staged bytes ARE the payload's content).
ARG SIDECAR=output/peakbot-windows-amd64-msvc.exe
COPY ${SIDECAR} /src/desktop/src-tauri/binaries/peakbot-x86_64-pc-windows-msvc.exe

# Fail the build if the desktop workspace version drifted from the root.
RUN sh /src/desktop/scripts/check-version.sh

# The desktop build. `--features tauri/custom-protocol`: embed ui/ (the
# status + settings pages) — what `tauri build` enables implicitly.
# `--locked`: cargo honors the committed desktop Cargo.lock.
WORKDIR /src/desktop
RUN cargo xwin build --release --locked -p peakbot-desktop \
        --target x86_64-pc-windows-msvc --features tauri/custom-protocol

# Name the portable per DESIGN §5.7 and copy it out BEFORE the CLI step
# (I-C: the CLI patches + rebuilds target/…/peakbot-desktop.exe in place,
# so the portable must be captured while it is still the plain cargo xwin
# output — byte-identical to the proven pipeline).
RUN mkdir -p /out && cp target/x86_64-pc-windows-msvc/release/peakbot-desktop.exe /out/PeakBot-Desktop-${VERSION}-windows-x86_64-portable.exe

# NSIS installer (per-user install + WebView2 downloadBootstrapper, per
# tauri.conf.json's bundle.windows): the pinned Tauri CLI bundles the same
# warm target/ with makensis. `--config` drops externalBin for THIS build
# only (I-B: the installer must not carry a second, unused peakbot.exe;
# build.rs still embeds the staged sidecar — S-W6 proves both on the
# artifact).
WORKDIR /src/desktop/src-tauri
RUN npx --yes @tauri-apps/cli@2.12.3 build --ci --bundles nsis --runner cargo-xwin \
        --target x86_64-pc-windows-msvc --config '{"bundle":{"externalBin":[]}}' -- --locked

# Exactly one installer: glob the bundle output, count, copy under the
# contract name.
RUN set -eu; set -- ../target/x86_64-pc-windows-msvc/release/bundle/nsis/*-setup.exe; [ "$#" -eq 1 ] && [ -f "$1" ] \
    || { echo "expected exactly one NSIS installer, got: $*" >&2; exit 1; }; \
    cp "$1" /out/PeakBot-Desktop-${VERSION}-windows-x86_64-setup.exe

# Smoke BOTH artifacts (S-W1..S-W6) before exporting. The staged sidecar is
# passed so S-W4/S-W6 can verify the embedded payload id matches the
# payload's content (I-D: one identity in both artifacts).
WORKDIR /src/desktop
RUN sh scripts/smoke-windows.sh /out/PeakBot-Desktop-${VERSION}-windows-x86_64-portable.exe \
        /out/PeakBot-Desktop-${VERSION}-windows-x86_64-setup.exe ${VERSION} \
        src-tauri/binaries/peakbot-x86_64-pc-windows-msvc.exe

# Two-file export.
FROM scratch
COPY --from=build /out/ /
