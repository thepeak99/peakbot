# PeakBot Linux Builder
# Usage: podman build -f Dockerfile.linux --output type=local,dest=./output .
# (or: docker build -f Dockerfile.linux --output type=local,dest=./output .)
#
# Default target is `x86_64-unknown-linux-gnu`. Override with --build-arg TARGET=...
# (e.g. aarch64-unknown-linux-gnu — note that requires an appropriate cross
# linker which this Dockerfile does not currently install).

# ── Web UI build (Node) ────────────────────────────────────────────────
# Stage `web`: produces /web/dist with the SPA bundle. The rust build copies
# this into the crate root so `rust-embed` inlines it.
FROM node:22 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ── Rust build ─────────────────────────────────────────────────────────
# Stage `builder`: owns the entire cargo build, including the final binary
# that the scratch stage exports. This stage MUST be referenced by the final
# `COPY --from=`, otherwise BuildKit will prune it along with the binary.
FROM rust:1.100.0-bookworm AS builder

ARG TARGET=x86_64-unknown-linux-gnu
ENV TARGET=${TARGET}

RUN rustup target add ${TARGET} \
    && rustup target list --installed

WORKDIR /build
COPY Cargo.toml Cargo.lock* ./
# vendor/ must land before the dep-cache build: [patch.crates-io] in
# Cargo.toml resolves termios from this vendored path (see vendor/README.md).
COPY vendor/ vendor/
# cargo loads every workspace member manifest (mobile/src-tauri and
# crates/cloud and crates/relay included), and their [lib]s need the default src/lib.rs —
# empty stubs, created below.
COPY mobile/src-tauri/Cargo.toml mobile/src-tauri/Cargo.toml
COPY crates/cloud/Cargo.toml crates/cloud/Cargo.toml
COPY crates/relay/Cargo.toml crates/relay/Cargo.toml

RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs && \
    mkdir -p mobile/src-tauri/src && \
    touch mobile/src-tauri/src/lib.rs && \
    mkdir -p crates/cloud/src && \
    touch crates/cloud/src/lib.rs && \
    mkdir -p crates/relay/src && \
    touch crates/relay/src/lib.rs

# crates/cloud pulls perma-crypto (a private git repo), which cargo fetches
# even when building only the root crate. The token crosses the build
# boundary as a BuildKit secret (Makefile: --secret id=perma_crypto_token,
# env=PERMA_CRYPTO_TOKEN) and is mounted into THIS step only; the
# repo-scoped insteadOf lives in GIT_CONFIG_* process env, so no token
# ever lands in a layer.
RUN --mount=type=secret,id=perma_crypto_token \
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0="url.https://x-access-token:$(cat /run/secrets/perma_crypto_token)@git.patchnotes.com/ai-bots/perma-crypto.insteadOf" \
    GIT_CONFIG_VALUE_0="https://git.patchnotes.com/ai-bots/perma-crypto" \
    cargo build --target ${TARGET} --release --locked && \
    rm -rf target/${TARGET}/deps/*.rlib target/${TARGET}/deps/*.d

# build.rs MUST be in the COPY set — the dummy-main dep-cache layer doesn't
# run it, and a new build.rs would otherwise silently never execute.
# `build/` is required because build.rs uses `include_str!("build/stub_index.html")`
# at compile time (the fail-safe stub for node-free builds); without it the
# build script itself fails to compile.
# web/dist is the Node-built SPA bundle.
COPY build.rs ./
COPY build/ build/
COPY --from=web /web/dist ./web/dist
COPY src/ src/

# Touch ALL workspace .rs sources (not just main.rs) so cargo recompiles the
# real cloud crate, not the empty stub that was baked into the dep cache.
RUN find src crates -name '*.rs' -exec touch {} + && \
    cargo build --target ${TARGET} --release --locked

FROM scratch
ARG TARGET=x86_64-unknown-linux-gnu
ARG VERSION=
COPY --from=builder /build/target/${TARGET}/release/peakbot /peakbot${VERSION:+-${VERSION}}-linux-amd64