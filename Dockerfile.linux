# PeakBot Linux Builder
# Usage: podman build -f Dockerfile.linux --output type=local,dest=./output .
# (or: docker build -f Dockerfile.linux --output type=local,dest=./output .)
#
# Default target is `x86_64-unknown-linux-gnu`. Override with --build-arg TARGET=...
# (e.g. aarch64-unknown-linux-gnu — note that requires an appropriate cross
# linker which this Dockerfile does not currently install).

FROM ghcr.io/rust-lang/rust:1.91-bookworm AS builder

# Default build target
ARG TARGET=x86_64-unknown-linux-gnu
ENV TARGET=${TARGET}

# Add the target (no-op when it's the image's native target)
RUN rustup target add ${TARGET} \
    && rustup target list --installed

# ── Web UI build (Node) ────────────────────────────────────────────────
# Produces /web/dist with the SPA bundle. The Rust build copies this
# into the crate root so `rust-embed` inlines it. `release` builds
# embed the bytes; `cargo run` (debug) reads from disk — same artefact,
# either path works.
FROM node:22 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Copy manifests first for better layer caching
WORKDIR /build
COPY Cargo.toml Cargo.lock* ./

# Create dummy main.rs for dependency caching
RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs

# Build dependencies only (faster layer caching)
RUN cargo build --target ${TARGET} --release && \
    rm -rf target/${TARGET}/deps/*.rlib target/${TARGET}/deps/*.d

# Copy actual source. build.rs MUST be in the COPY set — the dummy-main
# dep-cache layer doesn't run it, and a new build.rs would otherwise
# silently never execute. `web/dist` is the Node-built SPA bundle.
COPY build.rs ./
COPY --from=web /web/dist ./web/dist
COPY src/ src/

# Build the actual binary (touch main.rs so cargo rebuilds the bin crate; deps stay cached)
RUN touch src/main.rs && \
    cargo build --target ${TARGET} --release

# Export only the binary, named with the release/version + platform suffix so
# the Makefile doesn't have to rename it post-build.
# `ARG` works fine in scratch stages — BuildKit resolves it at build time, so
# both source and destination paths can interpolate it directly without an
# intermediate "extract" stage.
FROM scratch
ARG TARGET=x86_64-unknown-linux-gnu
# VERSION is injected by `make release-build-linux` from .release-version.
# Unset (default): artifact is `peakbot-linux-amd64`.
# Set to e.g. 0.2.0: artifact is `peakbot-0.2.0-linux-amd64`.
ARG VERSION=
COPY --from=builder /build/target/${TARGET}/release/peakbot /peakbot${VERSION:+-${VERSION}}-linux-amd64
