# PeakBot Linux Builder
# Usage: podman build -f Dockerfile.linux --output type=local,dest=./output .
# (or: docker build -f Dockerfile.linux --output type=local,dest=./output .)
#
# Default target is `x86_64-unknown-linux-gnu`. Override with --build-arg TARGET=...
# (e.g. aarch64-unknown-linux-gnu — note that requires an appropriate cross
# linker which this Dockerfile does not currently install).

# ── Web UI build (Node) ────────────────────────────────────────────────
# Stage `web`: produces /web/dist with the SPA bundle. The rust build copies
# this into the crate root so `rust-embed` inlines it.
FROM node:22 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ── Rust build ─────────────────────────────────────────────────────────
# Stage `builder`: owns the entire cargo build, including the final binary
# that the scratch stage exports. This stage MUST be referenced by the final
# `COPY --from=`, otherwise BuildKit will prune it along with the binary.
FROM ghcr.io/rust-lang/rust:1.91-bookworm AS builder

ARG TARGET=x86_64-unknown-linux-gnu
ENV TARGET=${TARGET}

RUN rustup target add ${TARGET} \
    && rustup target list --installed

WORKDIR /build
COPY Cargo.toml Cargo.lock* ./

RUN mkdir -p src && \
    echo "fn main() {}" > src/main.rs

RUN cargo build --target ${TARGET} --release && \
    rm -rf target/${TARGET}/deps/*.rlib target/${TARGET}/deps/*.d

# build.rs MUST be in the COPY set — the dummy-main dep-cache layer doesn't
# run it, and a new build.rs would otherwise silently never execute.
# web/dist is the Node-built SPA bundle.
COPY build.rs ./
COPY --from=web /web/dist ./web/dist
COPY src/ src/

RUN touch src/main.rs && \
    cargo build --target ${TARGET} --release

FROM scratch
ARG TARGET=x86_64-unknown-linux-gnu
ARG VERSION=
COPY --from=builder /build/target/${TARGET}/release/peakbot /peakbot${VERSION:+-${VERSION}}-linux-amd64